# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Deployment
APP_IMAGE=ghcr.io/your-user/content-app:prod
DOMAIN=203-0-113-10.sslip.io
APP_BASE_URL=https://203-0-113-10.sslip.io
POSTGRES_PASSWORD=change-me

# Managed Postgres connection (enable SSL if required by provider)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Optional HikariCP tuning
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT_MS=

# FFmpeg path (inside container)
APP_FFMPEG_LOCATION=/usr/bin/ffmpeg

# yt-dlp path (inside container). Leave blank for local dev to use auto-discovery
# via COMMON_BIN_DIRS in DefaultProcessExecutor (/opt/homebrew/bin, /usr/local/bin, /usr/bin).
APP_YTDLP_LOCATION=/usr/bin/yt-dlp

# TikTok embed fallback for yt-dlp challenge failures.
APP_TIKTOK_EMBED_FALLBACK_ENABLED=true
APP_TIKTOK_EMBED_CONNECT_TIMEOUT_SECONDS=10
APP_TIKTOK_EMBED_READ_TIMEOUT_SECONDS=30
APP_TIKTOK_EMBED_MAX_HTML_BYTES=2097152
APP_TIKTOK_EMBED_MAX_MEDIA_BYTES=157286400

# OpenAI API key (used by the application)
OPENAI_API_KEY=
# OpenAI mode: `real` or `mock`
APP_OPENAI_MODE=real

# JWT
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=7776000000

# Admin endpoint secret — anyone calling /api/admin/** must pass this as X-Admin-Secret header
# Generate with: openssl rand -base64 32
ADMIN_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=

# Google Play Billing Configuration
GOOGLE_PLAY_PACKAGE_NAME=com.contentcategorise.transcribeassistant
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=/path/to/google-play-service-account.json
GOOGLE_PLAY_PRODUCT_ID_MONTHLY=premium_monthly


# Apple App Store configuration
APPLE_ENVIRONMENT=production
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Absolute path on the VM/host to the downloaded Apple .p8 key file.
APPLE_PRIVATE_KEY_HOST_PATH=/opt/content-categorise/secrets/AuthKey_ABC123DEFG.p8
# Path inside the container where the key is mounted.
APPLE_PRIVATE_KEY_PATH=/app/secrets/apple-app-store-key.p8
APPLE_MONTHLY_PRODUCT_ID=scoop
